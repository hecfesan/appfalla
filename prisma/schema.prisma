generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  numericId    Int?     @unique
  username     String   @unique
  email        String?  @unique
  name         String
  password     String
  tokenBalance Int      @default(0)
  role         String   @default("CONSUMER") // CONSUMER, ADMIN, SUPER_ADMIN
  orders       Order[]
  redemptions  Redemption[]
  mealSubscriptions MealSubscription[]
  tokenAdjustments TokenAdjustment[]
  eventSubscriptions EventSubscription[]
  createdAt    DateTime @default(now())
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  tokensAmount  Int
  paymentMethod String   // CASH, ONLINE
  status        String   @default("PENDING") // PENDING, VALIDATED
  createdAt     DateTime @default(now())
}

model Redemption {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  tokensAmount  Int
  status        String   @default("PENDING") // PENDING, VALIDATED, REJECTED
  createdAt     DateTime @default(now())
}

model Dish {
  id    String @id @default(cuid())
  name  String @unique
}

model Meal {
  id        String   @id @default(cuid())
  dishName  String
  date      DateTime
  type      String   // "ADULT" | "CHILD"
  price     Float
  createdAt DateTime @default(now())

  subscriptions MealSubscription[]
}

model MealSubscription {
  id        String   @id @default(cuid())
  userId    String
  mealId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  meal      Meal     @relation(fields: [mealId], references: [id])

  @@unique([userId, mealId])
}

model TokenAdjustment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  adminId      String?  
  amount       Int
  createdAt    DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  date        DateTime
  createdAt   DateTime @default(now())

  subscriptions EventSubscription[]
}

model EventSubscription {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}
